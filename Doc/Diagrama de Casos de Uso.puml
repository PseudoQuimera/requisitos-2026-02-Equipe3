@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Docente" as AT01
actor "Gestor de internacionalização" as AT02
actor "Analista de internacionalização" as AT03
actor "Responsável pela pesquisa científica" as AT04
actor "Administrador do sistema" as AT05
