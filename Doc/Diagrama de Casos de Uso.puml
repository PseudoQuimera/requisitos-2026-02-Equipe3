rectangle "GPCID — Sistema de Gestão da Produção Científica e Internacionalização Docente" {
  usecase "CDU-01\nConsultar informações\ncurriculares, formação e titulação" as CDU01
  usecase "CDU-03\nConsultar publicações científicas" as CDU03
  usecase "CDU-04\nClassificar internacionalização\ndas produções" as CDU04
  usecase "CDU-06\nConsultar colaborações científicas" as CDU06
