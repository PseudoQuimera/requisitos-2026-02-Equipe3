  usecase "CDU-10\nConsultar indicadores" as CDU10
  usecase "CDU-11\nGerar relatórios" as CDU11
  usecase "CDU-12\nConfigurar indicadores" as CDU12
  usecase "CDU-13\nVersionar indicadores" as CDU13
  usecase "CDU-14\nIdentificar e analisar\ndivergências" as CDU14
  usecase "CDU-15\nConsultar origem e histórico\nde atualização dos dados" as CDU15
  usecase "CDU-16\nConsultar situação das integrações" as CDU16
  usecase "CDU-17\nAdministrar usuários e permissões" as CDU17
}
